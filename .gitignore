# macOS
.DS_Store

# Environment variables and secrets
.env
.env.*
!.env.example

# Private keys and PKCS bundles (never commit)
*.key
*.pem
*.p12
*.pfx

# Public certificates may be committed (tls/certs/server.crt)
!tls/certs/*.crt
!tls/certs/.gitkeep

# Logs
*.log
logs/

# Dependencies
node_modules/
.venv/
venv/

# Temporary files
*.tmp
*.swp

# Local editor settings
.vscode/
.idea/
