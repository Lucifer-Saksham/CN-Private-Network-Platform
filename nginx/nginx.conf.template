# Portable Nginx configuration.
# Replace every occurrence of REPO_ROOT with the absolute path of this
# repository on the Nginx host (Mac 2). Example:
#   /Users/kavyamukhija/Desktop/CN-Private-Network-Platform
#
# Then validate:
#   nginx -t -c REPO_ROOT/nginx/nginx.conf
#
# The live Mac 2 file is nginx/nginx.conf and currently uses Kavya's
# Desktop path. Keep that file aligned with the running service.

worker_processes 1;
error_log /tmp/cn-nginx-error.log;
pid /tmp/cn-nginx.pid;

events {
    worker_connections 128;
}

http {
    default_type application/octet-stream;
    access_log /tmp/cn-nginx-access.log;
    sendfile on;
    keepalive_timeout 15;

    upstream backends {
        server 10.3.3.71:3001;
        server 10.3.3.104:3002;
    }

    server {
        listen 8080;
        server_name app.teamX.test api.teamX.test;

        location / {
            proxy_pass http://backends;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    server {
        listen 443 ssl;
        server_name app.teamX.test api.teamX.test;

        ssl_certificate     REPO_ROOT/tls/certs/server.crt;
        ssl_certificate_key REPO_ROOT/tls/certs/server.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        location / {
            proxy_pass http://backends;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
