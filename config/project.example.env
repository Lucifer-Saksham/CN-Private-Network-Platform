# ---------------------------------------------------------------------------
# Central project settings. Every script reads these through scripts/common.sh.
# Precedence: process environment > ~/.config/cn-phase1/project.env > this file.
# Setup scripts ask for missing values on first run and save them to the
# user file (chmod 600). Do not duplicate these constants anywhere else.
# ---------------------------------------------------------------------------

TEAM=teamX                       # -> app.teamX.test / api.teamX.test
NETWORK_MODE=lan                 # lan | tunnel
ROLE=                            # saksham | kavya | shubham | divyanshi (saved by setup)

# --- LAN addresses (Task A). Fill in during setup. -------------------------
DNS_IP=10.3.3.96                 # Mac 1 (Saksham) private IP
EDGE_IP=10.3.3.178               # Mac 2 (Kavya) private IP
SHUBHAM_LAN_IP=10.3.3.71         # Mac 3 private IP (lan mode upstream)
DIVYANSHI_LAN_IP=10.3.3.104      # Mac 4 private IP (lan mode upstream)
LAN_SUBNET=10.3.0.0/22
LAN_NETMASK=255.255.252.0
LAN_GATEWAY=10.3.0.1

# --- Ports ----------------------------------------------------------------
DNS_PORT=53
EDGE_PORT=8443                   # 443 needs root; 8443 is allowed by the brief
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002

# --- Tunnel mode (Cloudflare Zero Trust private network) ------------------
TUNNEL_EDGE_IP=10.250.0.2        # virtual IP routed to Kavya's edge tunnel
TUNNEL_EDGE_NAME=cn-edge
TUNNEL_A_IP=10.250.0.3           # virtual IP routed to Shubham's tunnel
TUNNEL_B_IP=10.250.0.4           # virtual IP routed to Divyanshi's tunnel
TUNNEL_A_NAME=cn-backend-a
TUNNEL_B_NAME=cn-backend-b

# --- Backend identity -----------------------------------------------------
BACKEND_A_OWNER=Shubham
BACKEND_B_OWNER=Divyanshi

# --- nginx behaviour ------------------------------------------------------
UPSTREAM_MAX_FAILS=1
UPSTREAM_FAIL_TIMEOUT=5s
UPSTREAM_CONNECT_TIMEOUT=2s

# --- Test behaviour -------------------------------------------------------
LB_SAMPLE_REQUESTS=8
# 1 = resolve names through the macOS resolver (real demo).
# 0 = single-machine simulation only (uses dig + curl --resolve).
TEST_USE_SYSTEM_RESOLVER=1

# --- DNS ------------------------------------------------------------------
DNS_TTL=300                      # seconds; the Extension B demo (bin/phase2 ttl) lowers it temporarily and restores it

# --- Phase 2 (LAN mode only; `bin/phase2 setup` turns it on and sets PHASE2=1) ---
# You normally set NOTHING here: the values below are derived from the Phase 1 IPs.
#PHASE2=1
DNS2_IP=10.3.3.178               # backup DNS on Kavya's Mac
STANDBY_EDGE_IP=10.3.3.104       # standby nginx on Divyanshi's Mac
#ACTIVE_EDGE=primary             # which edge DNS points at: primary | standby (changed by `bin/phase2 cutover`)
DEMO_TTL=30                      # TTL (seconds) used by the Extension B/E demos; DNS_TTL stays 300 otherwise
